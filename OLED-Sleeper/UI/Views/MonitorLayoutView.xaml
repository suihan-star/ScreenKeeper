<UserControl x:Class="OLED_Sleeper.UI.Views.MonitorLayoutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:OLED_Sleeper.UI.Converters" xmlns:l="clr-namespace:OLED_Sleeper.UI.Localization" x:Name="LayoutRoot">
    <UserControl.Resources>
        <c:LeftTopToMarginConverter x:Key="LeftTop" />
        <c:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="MonitorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundColor}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource SecondaryBackgroundColor}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Monitors.Count, StringFormat={}{0:00}}" FontSize="26" FontWeight="Light" />
                <TextBlock Text="{l:Text Key=已连接显示器}" Style="{StaticResource MutedText}" />
                <TextBlock Text="{l:Text Key=点击屏幕}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,34,0,0" />
                <TextBlock Text="{l:Text Key=分别设置}" Style="{StaticResource MutedText}" FontSize="11" />
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Monitors}" SizeChanged="UserControl_SizeChanged">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid ClipToBounds="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="{Binding ScaledWidth}" Height="{Binding ScaledHeight}" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource MonitorButton}" Command="{Binding DataContext.SelectMonitorCommand, ElementName=LayoutRoot}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding MonitorTitle}">
                            <Button.Margin>
                                <MultiBinding Converter="{StaticResource LeftTop}">
                                    <Binding Path="ScaledLeft" />
                                    <Binding Path="ScaledTop" />
                                </MultiBinding>
                            </Button.Margin>
                            <Grid>
                                <Viewbox StretchDirection="DownOnly">
                                    <StackPanel MinWidth="150">
                                        <TextBlock Text="{Binding DisplayNumber, StringFormat={}{0:00}}" FontSize="28" FontWeight="Light" Margin="0,0,0,7" />
                                        <TextBlock Text="{Binding MonitorTitle}" FontSize="13" />
                                        <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBlock Text="{Binding Configuration.ManagementText}" Foreground="{DynamicResource AccentColorBrush}" FontSize="10" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Viewbox>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentColorBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{l:Text Key=此显示器有尚未保存的更改。}" Visibility="{Binding IsDirty, Converter={StaticResource BoolVisibility}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Grid.Column="1" Background="{DynamicResource SecondaryBackgroundColor}" Padding="15" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WorkspaceMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding WorkspaceMessage}" TextWrapping="Wrap" TextAlignment="Center" />
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource SecondaryBackgroundColor}" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{l:Text Key=正在识别显示器}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>