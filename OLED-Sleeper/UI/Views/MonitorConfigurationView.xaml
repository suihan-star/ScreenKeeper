<UserControl x:Class="OLED_Sleeper.UI.Views.MonitorConfigurationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:OLED_Sleeper.UI.Converters" xmlns:m="clr-namespace:OLED_Sleeper.Features.MonitorBehavior.Models" xmlns:u="clr-namespace:OLED_Sleeper.UI.Models" xmlns:p="clr-namespace:OLED_Sleeper.Features.MonitorPrivacy" xmlns:l="clr-namespace:OLED_Sleeper.UI.Localization" xmlns:v="clr-namespace:OLED_Sleeper.UI.Views">
    <UserControl.Resources>
        <c:EnumToBooleanConverter x:Key="EnumBool" />
        <c:BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding SavedRestRule}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ScrollViewer x:Name="RestScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,18,8,16"><StackPanel>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=开启此屏幕休息}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding RestEnabled}" Style="{StaticResource ManagementSwitch}" AutomationProperties.Name="{l:Text Key=开启此屏幕休息}"/>
            </Grid>
            <WrapPanel Margin="0,0,0,12"><Button Content="{Binding DataContext.PauseRestText, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.PauseRestCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,8"/><TextBlock Text="{Binding DataContext.RestRuntimeNotice, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></WrapPanel>
        <Grid Visibility="{Binding IsManaged, Converter={StaticResource BoolVisibility}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Text Key=空闲时的操作}" Style="{StaticResource SectionLabel}" />
                <UniformGrid Columns="2" ToolTip="{Binding BehaviorSectionTooltip}">
                    <RadioButton Content="{l:Text Key=遮黑}" Style="{StaticResource ModeButton}" GroupName="Behavior" IsChecked="{Binding Behavior, Converter={StaticResource EnumBool}, ConverterParameter={x:Static m:MonitorBehaviorType.Blackout}}" />
                    <RadioButton Content="{l:Text Key=调暗}" Style="{StaticResource ModeButton}" GroupName="Behavior" IsEnabled="{Binding IsDimBehaviorEnabled}" IsChecked="{Binding Behavior, Converter={StaticResource EnumBool}, ConverterParameter={x:Static m:MonitorBehaviorType.Dim}}" />
                </UniformGrid>
                <TextBlock Text="{Binding BehaviorError}" Style="{StaticResource ErrorText}" />
                <StackPanel Margin="0,6,0,0" Visibility="{Binding IsDimSliderEnabled, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{l:Text Key=目标亮度}" Style="{StaticResource MutedText}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DimLevel}" AutomationProperties.Name="{l:Text Key=目标亮度}" />
                        <TextBlock Grid.Column="1" Text="{Binding DimLevel, StringFormat={}{0:0}%}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <CheckBox Content="{l:Text Key=同时将亮度降至零}" IsChecked="{Binding LowerBrightnessOnBlackout}" IsEnabled="{Binding IsLowerBrightnessOptionEnabled}" ToolTip="{Binding LowerBrightnessTooltip}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlackout}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <StackPanel Visibility="{Binding IsSleepEnabled, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{l:Text Key=空闲多久后执行}" Style="{StaticResource SectionLabel}" Margin="0,20,0,10" />
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsSleepEnabled}">
                    <TextBox x:Name="IdleValueTextBox" Width="88" Text="{Binding IdleValueText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Text Key=空闲时长}" />
                    <ComboBox x:Name="TimeUnitSelector" Width="112" Margin="8,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTimeUnit}" AutomationProperties.Name="{l:Text Key=时间单位}">
                        <ComboBoxItem Tag="{x:Static u:TimeUnit.Seconds}" Content="{l:Text Key=秒}" />
                        <ComboBoxItem Tag="{x:Static u:TimeUnit.Minutes}" Content="{l:Text Key=分钟}" />
                        <ComboBoxItem Tag="{x:Static u:TimeUnit.Hours}" Content="{l:Text Key=小时}" />
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{Binding IdleValueError}" Style="{StaticResource ErrorText}" /></StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,24,0,0" Visibility="{Binding IsSleepEnabled, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{l:Text Key=保持唤醒的条件}" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{l:Text Key=满足以下任一条件，这块屏幕就保持唤醒。}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                <Border BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,1,0,1" Padding="0,3">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IsActiveOnMousePosition}" AutomationProperties.Name="{l:Text Key=鼠标位于此显示器}">
                            <StackPanel>
                                <TextBlock Text="{l:Text Key=鼠标位于此显示器}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Text Key=光标停留在这里时保持唤醒}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding IsActiveOnActiveWindow}" AutomationProperties.Name="{l:Text Key=当前活动窗口位于此显示器}">
                            <StackPanel>
                                <TextBlock Text="{l:Text Key=当前活动窗口位于此显示器}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Text Key=正在使用的窗口在这里时保持唤醒}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding IsActiveOnInput}" AutomationProperties.Name="{l:Text Key=系统有键盘或鼠标输入}">
                            <StackPanel>
                                <TextBlock Text="{l:Text Key=系统有键盘或鼠标输入}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Text Key=在任意屏幕操作时都保持唤醒}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ActiveConditionsError}" Style="{StaticResource ErrorText}" />
            </StackPanel>
        </Grid>
        <Button x:Name="CopySettingsButton" Content="{l:Text Key=应用到其他屏幕 ↗}" Click="Copy_Click" Style="{StaticResource ScreenSettingsLink}" Margin="0,16,0,0"/>
        </StackPanel></ScrollViewer>
    </DockPanel>
</UserControl>
