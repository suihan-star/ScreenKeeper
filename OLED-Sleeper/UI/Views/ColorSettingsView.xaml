<UserControl x:Class="OLED_Sleeper.UI.Views.ColorSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:OLED_Sleeper.UI.Localization" xmlns:c="clr-namespace:OLED_Sleeper.UI.Converters">
    <UserControl.Resources>
        <c:BooleanToVisibilityConverter x:Key="Bool"/>
        <SolidColorBrush x:Key="RestPeriodBrush" Color="#D3A66A"/>
        <Style x:Key="SchedulePeriodStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="ToolTip" Value="{Binding Label}"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsRest}" Value="True"><Setter Property="Background" Value="{StaticResource RestPeriodBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="TemperatureSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Minimum" Value="3500"/><Setter Property="Maximum" Value="6500"/>
            <Setter Property="TickFrequency" Value="100"/><Setter Property="SmallChange" Value="100"/><Setter Property="LargeChange" Value="500"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Height="32" Background="Transparent">
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="8,0">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#D3A66A" Offset="0"/><GradientStop Color="#DACCB1" Offset="0.5"/><GradientStop Color="#DCE7E6" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="20" Height="20"><Thumb.Template><ControlTemplate><Ellipse Fill="{DynamicResource PrimaryForegroundColor}" Stroke="{DynamicResource PrimaryBackgroundColor}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{l:Text Key=色温调节}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ActiveScreenSummary}" Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
            <TextBlock Text="{Binding Notice}" Style="{StaticResource MutedText}" FontSize="11" Visibility="{Binding HasNotice, Converter={StaticResource Bool}}"/>
        </StackPanel>
        <TabControl x:Name="ColorTabs" SelectedIndex="{Binding SelectedPage}">
            <TabItem Header="{l:Text Key=作息与色温}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,8,16">
                    <StackPanel>
                        <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="8" Padding="20" Visibility="{Binding HasNoVerifiedScreens, Converter={StaticResource Bool}}">
                            <StackPanel><TextBlock Text="{l:Text Key=先验证一块屏幕}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:Text Key=确认调色与恢复正常后，就能在这里为它设置独立作息。}" Style="{StaticResource MutedText}" Margin="0,8,0,16"/>
                                <Button Content="{l:Text Key=前往屏幕与验证}" Command="{Binding ConfigureScreensCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding HasVerifiedScreens, Converter={StaticResource Bool}}">
                            <ListBox x:Name="VerifiedScreenCards" ItemsSource="{Binding VerifiedScreens}" SelectedItem="{Binding SelectedScreen}" ItemContainerStyle="{StaticResource ScreenSelectorItem}" BorderThickness="0" Background="Transparent" Margin="0,0,0,14" Visibility="{Binding UseScreenCards, Converter={StaticResource Bool}}" AutomationProperties.Name="{l:Text Key=已验证屏幕}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate><StackPanel MaxWidth="150" ToolTip="{Binding SelectionLabel}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectionState}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <ComboBox ItemsSource="{Binding VerifiedScreens}" SelectedItem="{Binding SelectedScreen}" Margin="0,0,0,14" Visibility="{Binding UseScreenDropdown, Converter={StaticResource Bool}}" AutomationProperties.Name="{l:Text Key=已验证屏幕}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding SelectionLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionLabel}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{l:Text Key=开启此屏幕色温调节}" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><Border Background="{DynamicResource SelectedSurfaceBrush}" BorderBrush="{DynamicResource SeparatorColorBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,8,6" Visibility="{Binding SavedIsAutomatic, Converter={StaticResource Bool}}"><TextBlock Text="{Binding SavedWorkSummary}" FontSize="11"/></Border><Border Background="{DynamicResource RestSummaryBrush}" BorderBrush="{DynamicResource SeparatorColorBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,6"><TextBlock Text="{Binding SavedRestSummary}" FontSize="11"/></Border></WrapPanel><TextBlock Text="{Binding EnableStatus}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                    <CheckBox x:Name="ColorEnabledToggle" Grid.Column="1" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEnable}" Style="{StaticResource ManagementSwitch}" VerticalAlignment="Center" AutomationProperties.Name="{l:Text Key=开启此屏幕色温调节}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding SavedStateNotice}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,14"/>
                            <TextBlock Text="{l:Text Key=开启后设置工作与休息色温，保存后生效。原有数值会保留。}" Style="{StaticResource MutedText}" Visibility="{Binding IsScreenOff, Converter={StaticResource Bool}}"/>
                            <StackPanel Visibility="{Binding Enabled, Converter={StaticResource Bool}}" IsEnabled="{Binding CanEdit}">
                                <Expander Header="{l:Text Key=在此屏幕试调}" IsExpanded="{Binding TrialExpanded}" Margin="0,0,0,14">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding SelectedScreen.Name}" FontWeight="SemiBold"/><TextBlock Text="{l:Text Key=先开始试调，再拖动上方滑杆感受变化。停止调整 15 秒后恢复已保存策略。}" Style="{StaticResource MutedText}" Margin="0,6,0,12"/>
                                        <WrapPanel><Button Content="{l:Text Key=试调工作色温}" Command="{Binding PreviewWorkCommand}" Visibility="{Binding IsAutomatic, Converter={StaticResource Bool}}" Margin="0,0,8,8"/><Button Content="{l:Text Key=试调休息色温}" Command="{Binding PreviewRestCommand}" Margin="0,0,0,8"/></WrapPanel>
                                        <WrapPanel><Button x:Name="CompareOriginalButton" Content="{l:Text Key=按住对比原色}" IsEnabled="{Binding CanCompareOriginal}" Margin="0,0,8,8" PreviewMouseLeftButtonDown="CompareDown" PreviewMouseLeftButtonUp="CompareUp" LostMouseCapture="CompareCaptureLost" PreviewKeyDown="CompareKeyDown" PreviewKeyUp="CompareKeyUp" LostKeyboardFocus="CompareFocusLost"/><Button Content="{l:Text Key=结束试调}" Command="{Binding CancelPreviewCommand}" Margin="0,0,0,8"/></WrapPanel>
                                        <TextBlock Text="{Binding LivePreviewMessage}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Expander>
                                <UniformGrid Columns="{Binding TemperatureColumns}">
                                    <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="0,0,8,12" Visibility="{Binding IsAutomatic, Converter={StaticResource Bool}}">
                                        <StackPanel>
                                            <TextBlock Text="{l:Text Key=工作时}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                            <DockPanel Margin="0,0,0,14"><TextBox DockPanel.Dock="Right" Text="{Binding MorningStart, UpdateSourceTrigger=PropertyChanged}" Width="80" AutomationProperties.Name="{l:Text Key=工作时段开始}"/><TextBlock Text="{l:Text Key=开始时间}" VerticalAlignment="Center"/></DockPanel>
                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <RadioButton GroupName="WorkTarget" Content="{l:Text Key=保持原色}" Style="{StaticResource ModeButton}" IsChecked="{Binding DayUsesOriginal}" Padding="6,9" FontSize="11"/>
                                                <RadioButton GroupName="WorkTarget" Content="{l:Text Key=自定义色温}" Style="{StaticResource ModeButton}" IsChecked="{Binding UsesDayTemperature}" Padding="6,9" FontSize="11"/>
                                            </UniformGrid>
                                            <TextBlock Text="{l:Text Key=沿用屏幕接管前的原色，也可以切换为自定义色温。}" Style="{StaticResource MutedText}" FontSize="11" Visibility="{Binding DayUsesOriginal, Converter={StaticResource Bool}}"/>
                                            <StackPanel Visibility="{Binding UsesDayTemperature, Converter={StaticResource Bool}}">
                                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="K" VerticalAlignment="Center" Margin="6,0,0,0"/><TextBox Text="{Binding DayKelvin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Text Key=工作色温}"/></DockPanel>
                                                <Slider Style="{StaticResource TemperatureSlider}" Value="{Binding DaySlider}" AutomationProperties.Name="{l:Text Key=工作色温}"/>
                                                <Grid><TextBlock Text="{l:Text Key=偏暖}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{l:Text Key=偏中性}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/></Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{l:Text Key=休息时}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                            <DockPanel Margin="0,0,0,14" Visibility="{Binding IsAutomatic, Converter={StaticResource Bool}}"><TextBox DockPanel.Dock="Right" Text="{Binding EveningStart, UpdateSourceTrigger=PropertyChanged}" Width="80" AutomationProperties.Name="{l:Text Key=休息时段开始}"/><TextBlock Text="{l:Text Key=开始时间}" VerticalAlignment="Center"/></DockPanel>
                                            <UniformGrid Columns="2" Margin="0,0,0,10" Visibility="{Binding IsAutomatic, Converter={StaticResource Bool}}">
                                                <RadioButton GroupName="RestTarget" Content="{l:Text Key=保持原色}" Style="{StaticResource ModeButton}" IsChecked="{Binding NightUsesOriginal}" Padding="6,9" FontSize="11"/>
                                                <RadioButton GroupName="RestTarget" Content="{l:Text Key=自定义色温}" Style="{StaticResource ModeButton}" IsChecked="{Binding UsesNightTemperature}" Padding="6,9" FontSize="11"/>
                                            </UniformGrid>
                                            <TextBlock Text="{l:Text Key=沿用屏幕接管前的原色，也可以切换为自定义色温。}" Style="{StaticResource MutedText}" FontSize="11" Visibility="{Binding ShowRestOriginal, Converter={StaticResource Bool}}"/>
                                            <StackPanel Visibility="{Binding UsesNightTemperature, Converter={StaticResource Bool}}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="K" VerticalAlignment="Center" Margin="6,0,0,0"/><TextBox Text="{Binding NightKelvin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Text Key=休息色温}"/></DockPanel>
                                            <Slider Style="{StaticResource TemperatureSlider}" Value="{Binding NightSlider}" AutomationProperties.Name="{l:Text Key=休息色温}"/>
                                            <Grid><TextBlock Text="{l:Text Key=偏暖}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{l:Text Key=偏中性}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/></Grid>
                                        </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <StackPanel Visibility="{Binding IsAutomatic, Converter={StaticResource Bool}}" Margin="0,4,0,14">
                                    <TextBlock Text="{l:Text Key=当前编辑的作息}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding ScheduleInputHint}" Style="{StaticResource NoticeText}"/>
                                    <Grid x:Name="ScheduleTimeline" Margin="0,4,0,6" Visibility="{Binding HasValidSchedule, Converter={StaticResource Bool}}" AutomationProperties.Name="{l:Text Key=当前编辑的作息}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SchedulePeriods[0].Width}"/><ColumnDefinition Width="{Binding SchedulePeriods[1].Width}"/><ColumnDefinition Width="{Binding SchedulePeriods[2].Width}"/></Grid.ColumnDefinitions>
                                        <Border DataContext="{Binding SchedulePeriods[0]}" Style="{StaticResource SchedulePeriodStyle}"/><Border Grid.Column="1" DataContext="{Binding SchedulePeriods[1]}" Style="{StaticResource SchedulePeriodStyle}"/><Border Grid.Column="2" DataContext="{Binding SchedulePeriods[2]}" Style="{StaticResource SchedulePeriodStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8"><TextBlock Text="00:00" Style="{StaticResource MutedText}"/><TextBlock Text="12:00" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/><TextBlock Text="24:00" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock Text="{Binding WorkScheduleLabel}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding RestScheduleLabel}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBlock Text="{Binding ScheduleTransitionLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Expander Header="{l:Text Key=更多设置}"><StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{l:Text Key=调节方式}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Mode}" HorizontalAlignment="Left" MinWidth="180" Margin="0,0,0,14" AutomationProperties.Name="{l:Text Key=调节方式}"><ComboBoxItem Tag="Automatic" Content="{l:Text Key=固定作息}"/><ComboBoxItem Tag="Manual" Content="{l:Text Key=手动暖色}"/></ComboBox>
                                    <DockPanel Margin="0,0,0,14" Visibility="{Binding IsAutomatic, Converter={StaticResource Bool}}"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox Text="{Binding TransitionMinutes, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="{l:Text Key=过渡时间}"/><TextBlock Text="{l:Text Key=分钟}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{l:Text Key=逐渐过渡}" VerticalAlignment="Center"/></DockPanel>
                                    <TextBlock Text="{l:Text Key=临时操作立即作用于已保存策略，不会保存上方草稿。}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8"/>
                                    <WrapPanel><Button Content="{l:Text Key=原色 1 小时}" Command="{Binding SelectedScreen.OriginalCommand}" Margin="0,0,8,8"/><Button Content="{l:Text Key=原色至下次工作时间}" Command="{Binding SelectedScreen.UntilMorningCommand}" Margin="0,0,8,8"/><Button Content="{l:Text Key=恢复已保存策略}" Command="{Binding SelectedScreen.ResumeCommand}" Margin="0,0,0,8"/></WrapPanel>
                                    <TextBlock Text="{l:Text Key=范围 3500–6500 K，为软件估算目标；原色使用接管前基线。}" Style="{StaticResource MutedText}" FontSize="11"/>
                                </StackPanel></Expander>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Text Key=屏幕与验证}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,8,16"><StackPanel>
                <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="{l:Text Key=重新检测}" Command="{Binding RefreshScreensCommand}" Margin="12,0,0,0"/><TextBlock Text="{l:Text Key=验证通过后，返回作息与色温开启并保存。}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></DockPanel>
                <TextBlock Text="{l:Text Key=未发现可检测的屏幕，请检查连接后重试。}" Style="{StaticResource MutedText}" Visibility="{Binding HasNoScreens, Converter={StaticResource Bool}}"/>
                <ItemsControl ItemsSource="{Binding Screens}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                        <CheckBox Content="{l:Text Key=开启此屏幕色温调节}" IsChecked="{Binding Selected}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding CanTurnOffHere, Converter={StaticResource Bool}}" Margin="0,0,0,12"/>
                        <Button Content="{Binding PrimaryActionText}" Click="ScreenSetup_Click" HorizontalAlignment="Left" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer></TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
