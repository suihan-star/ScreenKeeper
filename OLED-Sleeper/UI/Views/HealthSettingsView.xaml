<UserControl x:Class="OLED_Sleeper.UI.Views.HealthSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:OLED_Sleeper.UI.Localization" xmlns:c="clr-namespace:OLED_Sleeper.UI.Converters">
    <UserControl.Resources><c:BooleanToVisibilityConverter x:Key="Bool"/></UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="{l:Text Key=健康提醒}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{l:Text Key=全局工作节奏，跟随你在不同屏幕间切换。}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding EnableStatus}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/><CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding IsAvailable}" Style="{StaticResource ManagementSwitch}" AutomationProperties.Name="{l:Text Key=启用健康提醒}"/></StackPanel>
            </Grid>
            <Border Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding Remaining}" FontSize="24" FontWeight="Light"/></StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="260"><Button Content="{l:Text Key=现在休息}" Command="{Binding StartBreakCommand}" Margin="0,0,6,4" Padding="8,5" MinHeight="30"/><Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" Margin="0,0,0,4" Padding="8,5" MinHeight="30"/></WrapPanel>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Notice}" Style="{StaticResource NoticeText}"/>
        </StackPanel>
        <TabControl x:Name="HealthTabs" SelectedIndex="{Binding SelectedPage}">
            <TabItem Header="{l:Text Key=提醒节奏}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,8,16"><StackPanel>
            <WrapPanel>
                <StackPanel Margin="0,0,24,16"><TextBlock Text="{l:Text Key=工作多久后提醒}" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding WorkMinutes, UpdateSourceTrigger=PropertyChanged}" Width="75"/><TextBlock Text="{l:Text Key=分钟}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></StackPanel>
                <StackPanel Margin="0,0,24,16"><TextBlock Text="{l:Text Key=休息倒计时}" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding RestValue, UpdateSourceTrigger=PropertyChanged}" Width="75"/><ComboBox Width="86" Margin="8,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding RestUnit}"><ComboBoxItem Tag="Seconds" Content="{l:Text Key=秒}"/><ComboBoxItem Tag="Minutes" Content="{l:Text Key=分钟}"/></ComboBox></StackPanel></StackPanel>
                <StackPanel Margin="0,0,0,16"><TextBlock Text="{l:Text Key=稍后再提醒}" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding SnoozeMinutes, UpdateSourceTrigger=PropertyChanged}" Width="75"/><TextBlock Text="{l:Text Key=分钟}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></StackPanel>
            </WrapPanel>
            <TextBlock Text="{l:Text Key=提醒时可稍后或跳过，点击开始休息才启动倒计时。}" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
            <TextBlock Visibility="{Binding IsDirty, Converter={StaticResource Bool}}" Text="{l:Text Key=新时长在下一周期生效，运行中的休息或稍后计时保持不变。}" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <Border BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,1,0,1" Padding="0,18" Margin="0,0,0,18"><StackPanel>
                <TextBlock Text="{l:Text Key=减少打扰}" Style="{StaticResource SectionLabel}"/>
                <CheckBox IsChecked="{Binding FullscreenDnd}" Content="{l:Text Key=全屏使用时暂不提醒}"/>
            </StackPanel></Border>
            <TextBlock Text="{l:Text Key=更多设置}" Style="{StaticResource SectionLabel}"/>
            <StackPanel>
            <CheckBox IsChecked="{Binding PauseOnIdle}" Content="{l:Text Key=连续 5 分钟无输入时暂停累计}" Margin="0,0,0,10"/>
            <TextBlock Text="{l:Text Key=无输入不代表已经休息。锁屏或系统休眠时暂停工作计时。}" Style="{StaticResource MutedText}"/>
</StackPanel>

            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="{l:Text Key=提醒外观}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,8,16"><StackPanel>
                <TextBlock Text="{l:Text Key=先选择阶段，再调整它的外观。}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <UniformGrid Columns="2" Margin="0,0,0,18"><RadioButton GroupName="AppearanceStage" IsChecked="{Binding PreviewReminderStage}" Content="{l:Text Key=提醒时}" Style="{StaticResource ModeButton}"/><RadioButton GroupName="AppearanceStage" IsChecked="{Binding PreviewRestStage}" Content="{l:Text Key=开始休息后}" Style="{StaticResource ModeButton}"/></UniformGrid>
                <Grid x:Name="AppearanceGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="PreviewColumn" Width="250"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="AppearanceOptions" Margin="0,0,16,0">
                        <StackPanel Visibility="{Binding PreviewReminderStage, Converter={StaticResource Bool}}"><TextBlock Text="{l:Text Key=提醒样式}" Style="{StaticResource SectionLabel}"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ReminderStyle}" Margin="0,0,0,18"><ComboBoxItem Tag="Scenic" Content="{l:Text Key=静景渐显}"/><ComboBoxItem Tag="EdgeGlow" Content="{l:Text Key=雾光漫入}"/><ComboBoxItem Tag="Compact" Content="{l:Text Key=简洁卡片}"/></ComboBox></StackPanel>
                        <StackPanel Visibility="{Binding PreviewRestStage, Converter={StaticResource Bool}}"><TextBlock Text="{l:Text Key=休息画面}" Style="{StaticResource SectionLabel}"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RestStyle}" Margin="0,0,0,18"><ComboBoxItem Tag="Night" Content="{l:Text Key=静夜微动}"/><ComboBoxItem Tag="Picture" Content="{l:Text Key=背景图片}"/></ComboBox></StackPanel>
            <StackPanel Visibility="{Binding StageUsesPicture, Converter={StaticResource Bool}}" Margin="0,0,0,16">
                <TextBlock Text="{Binding ImageStatus}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <WrapPanel><Button Content="{l:Text Key=选择图片}" Command="{Binding ImportImageCommand}" Margin="0,0,8,8"/><Button Content="{l:Text Key=使用默认背景}" Command="{Binding ResetImageCommand}" Margin="0,0,0,8"/></WrapPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding StageUsesOverlay, Converter={StaticResource Bool}}" Margin="0,0,0,14">
                <Grid><TextBlock Text="{l:Text Key=渐显时间}"/><TextBlock HorizontalAlignment="Right" Text="{Binding FadeSeconds, StringFormat={}{0} s}"/></Grid>
                <Slider Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FadeSeconds}" Margin="0,8,0,16"/>
                <Grid><TextBlock Text="{l:Text Key=覆盖程度}"/><TextBlock HorizontalAlignment="Right" Text="{Binding OverlayPercent, StringFormat={}{0}%}"/></Grid>
                <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding OverlayPercent}" Margin="0,8,0,4"/>
            </StackPanel>
<StackPanel Visibility="{Binding StageUsesMotion, Converter={StaticResource Bool}}">            <CheckBox Content="{l:Text Key=启用轻微动态}" IsChecked="{Binding MotionEnabled}" Margin="0,0,0,12"/>
            <StackPanel Visibility="{Binding MotionEnabled, Converter={StaticResource Bool}}" Margin="0,0,0,14"><TextBlock Text="{l:Text Key=动态强度}"/><Slider Minimum="1" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MotionStrength}" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
            <TextBlock Text="{l:Text Key=遵循系统减少动画设置。全屏免打扰仅影响自动提醒，手动预览仍可使用。}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
</StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PreviewPanel" Grid.Column="1" Margin="0,0,0,16">
                        <TextBlock Text="{l:Text Key=效果示意}" Style="{StaticResource SectionLabel}"/>
                        <Border Height="160" ClipToBounds="True" CornerRadius="8" Background="#17372E"><Grid>
                            <ContentControl x:Name="SceneHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsHitTestVisible="False"/>
                            <Border Background="#B3102A23" Padding="14" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220"><StackPanel><TextBlock Text="{l:Text Key=让视线，稍作停留}" Foreground="#E8EFE5" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="05:00" Foreground="#E8EFE5" FontSize="26" TextAlignment="Center" Visibility="{Binding PreviewRestStage, Converter={StaticResource Bool}}"/></StackPanel></Border>
                        </Grid></Border>
                        <TextBlock Text="{l:Text Key=局部示意；实际效果以屏幕预览为准。}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,12"/>
                        <Button Content="{l:Text Key=在屏幕上预览}" Command="{Binding PreviewCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </StackPanel></ScrollViewer></TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
