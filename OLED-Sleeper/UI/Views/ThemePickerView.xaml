<UserControl x:Class="OLED_Sleeper.UI.Views.ThemePickerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:OLED_Sleeper.UI.Localization">
    <StackPanel Margin="0,0,0,22">
        <TextBlock Text="{l:Text Key=外观主题}" Style="{StaticResource SectionLabel}"/>
        <ListBox SelectedValuePath="Tag" SelectedValue="{Binding Theme, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:Text Key=外观主题}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBoxItem Tag="forest"><StackPanel>
                <Border Background="#102A23" CornerRadius="7" Height="82" Padding="10" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#294C3C" CornerRadius="3" Margin="0,0,8,0"/><StackPanel Grid.Column="1"><Border Background="#ACC2B3" Width="50" Height="4" HorizontalAlignment="Left" Margin="0,7"/><Border Background="#17372E" Height="18" CornerRadius="3"/><Border Background="#B4D6A1" Width="30" Height="12" HorizontalAlignment="Right" CornerRadius="3" Margin="0,8,0,0"/></StackPanel></Grid></Border>
                <TextBlock Text="{l:Text Key=深绿}" FontWeight="SemiBold"/><TextBlock Text="{l:Text Key=默认 · 深绿底色，浅绿文字}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel></ListBoxItem>
            <ListBoxItem Tag="fog"><StackPanel>
                <Border Background="#EAF0E9" CornerRadius="7" Height="82" Padding="10" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#D3DFCE" CornerRadius="3" Margin="0,0,8,0"/><StackPanel Grid.Column="1"><Border Background="#526C5D" Width="50" Height="4" HorizontalAlignment="Left" Margin="0,7"/><Border Background="#F5F7F1" Height="18" CornerRadius="3"/><Border Background="#315F43" Width="30" Height="12" HorizontalAlignment="Right" CornerRadius="3" Margin="0,8,0,0"/></StackPanel></Grid></Border>
                <TextBlock Text="{l:Text Key=雾白绿}" FontWeight="SemiBold"/><TextBlock Text="{l:Text Key=浅绿灰底色，深绿文字}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel></ListBoxItem>
        </ListBox>
        <TextBlock Text="{l:Text Key=立即切换，记住你的选择。}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
