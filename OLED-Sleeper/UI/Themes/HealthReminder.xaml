<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Local to the reminder window: the complete icon-and-caption area remains clickable. -->
    <SolidColorBrush x:Key="HealthShapeBorder" Color="#829F8C" />
    <SolidColorBrush x:Key="HealthShapeFill" Color="#244738" />
    <Style x:Key="HealthShapeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundColor}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundColor}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HealthPauseButton" TargetType="Button" BasedOn="{StaticResource HealthShapeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <Border x:Name="Shape" Width="48" Height="48" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource HealthShapeBorder}" Background="Transparent">
                                <Canvas Width="20" Height="20">
                                    <Rectangle Canvas.Left="4" Canvas.Top="3" Width="4" Height="14" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}" />
                                    <Rectangle Canvas.Left="12" Canvas.Top="3" Width="4" Height="14" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}" />
                                </Canvas>
                            </Border>
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HealthSkipButton" TargetType="Button" BasedOn="{StaticResource HealthShapeButton}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <Canvas Width="54" Height="54">
                                <Path x:Name="Shape" Data="M8 5 H32 Q35 5 37 8 L49 24 Q51 27 49 30 L37 46 Q35 49 32 49 H8 Q4 49 4 45 V9 Q4 5 8 5 Z" Fill="{DynamicResource HealthShapeFill}" Stroke="{DynamicResource HealthShapeBorder}" StrokeThickness="1.1" StrokeLineJoin="Round" />
                                <Path Data="M20 19 L29 27 L20 35 M33 19 V35" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Fill" Value="{DynamicResource SelectedSurfaceBrush}" />
                            <Setter TargetName="Shape" Property="Stroke" Value="{DynamicResource AccentColorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
