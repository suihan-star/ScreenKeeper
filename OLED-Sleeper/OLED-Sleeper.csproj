<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OLED_Sleeper</RootNamespace>
    <AssemblyName>ScreenKeeper</AssemblyName>
    <Product>多屏管家 ScreenKeeper</Product>
    <Title>多屏管家 ScreenKeeper</Title>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- MinVer derives the version from the nearest screenkeeper-v* tag. It is the project's only version declaration. -->
  <PropertyGroup>
    <MinVerTagPrefix>screenkeeper-v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- Publishing with -p:Portable=true builds the portable distribution, which keeps its state in Data/ScreenKeeper beside the executable. -->
  <PropertyGroup Condition="'$(Portable)' == 'true'">
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\icon.ico" />
    <None Remove="Assets\icon-dark.ico" />
    <None Remove="Assets\forest-mist.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon-dark.ico" />
    <Resource Include="Assets\forest-mist.png" />
    <EmbeddedResource Include="UI/Localization/English.json" LogicalName="ScreenKeeper.English.json" />
  </ItemGroup>

</Project>
